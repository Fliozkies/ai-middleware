{
  "rewrites": [
    { "source": "/api/memory/(.*)", "destination": "/api/memory" },
    { "source": "/api/projects/:id/tree", "destination": "/api/project-tree?id=:id" },
    { "source": "/api/projects/:id/files", "destination": "/api/project-files?id=:id" },
    { "source": "/api/projects/:id/search", "destination": "/api/project-search?id=:id" },
    { "source": "/api/projects/:id", "destination": "/api/projects?id=:id" },
    { "source": "/api/tools/(.*)", "destination": "/api/tools" },
    { "source": "/api/projects", "destination": "/api/projects" },
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/snapshot", "destination": "/api/snapshot" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization, Content-Type" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" }
      ]
    }
  ]
}